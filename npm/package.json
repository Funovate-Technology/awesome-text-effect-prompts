    "font-effects",
    "dataset",
    "multilingual"
  ],
  "homepage": "https://fontvibe.ai/styles",
  "bugs": "https://github.com/Funovate-Technology/awesome-text-effect-prompts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funovate-Technology/awesome-text-effect-prompts.git",
    "directory": "npm"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "author": "Funovate Technology (https://fontvibe.ai)",
  "main": "./index.js",
  "module": "./index.mjs",
